; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="bobble-bubbles"
run/main_scene="uid://dcj8i1iuuxwol"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://misc/icon.svg"

[autoload]

GameManager="*uid://yb0vf6v8cxg7"
SaveManager="*uid://cq15sj4yslslg"

[dialogic]

directories/dch_directory={}
directories/dtl_directory={}
layout/style_directory={}

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/nhb_functions_on_the_fly/plugin.cfg", "res://addons/scenebuilder/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "red",
"res://common/": "orange",
"res://entities/": "yellow",
"res://misc/": "teal",
"res://script_templates/": "gray",
"res://stages/": "purple"
}

[global_group]

bubble_parent=""
bubble=""

[gui]

theme/default_font_multichannel_signed_distance_field=true

